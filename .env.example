# Postgres connection string (dev: shared Contabo Postgres with a dedicated `newsroom` DB/user;
# stage/prod-like docker-compose: the app's own `db` service — see docs/deploy.md)
DATABASE_URL=

# Payload CMS session/auth secret
PAYLOAD_SECRET=

# `npm run seed` (src/seed/index.ts) admin account — required in production (NODE_ENV=production,
# always true inside the Docker image): seed throws instead of falling back to a known default
# password. Re-running seed rotates this account's password to whatever is set here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Same deal for the demo editor@newsroom.test / author@newsroom.test accounts — editor
# can publish/unpublish articles just like admin, so a hardcoded demo password there is
# the same risk. One shared password for both (not a secret-naming mismatch; they're
# both low-stakes demo accounts, just not zero-stakes once editor can publish).
SEED_DEMO_PASSWORD=

# Public site identity (all brand/domain decisions are still pending — see project description)
SITE_URL=http://localhost:3000
SITE_NAME=Newsroom (sandbox)
# Home page <meta name="description">/og:description fallback (FACT-261)
SITE_DESCRIPTION=

# Base URL middleware uses for its own server-to-server status check (never the public
# SITE_URL — that hairpins back through the edge/proxy from inside the container and can
# fail silently, FACT-244). Defaults to http://127.0.0.1:${PORT:-3000}; only set this if
# the app doesn't listen on loopback:PORT (e.g. a different internal hostname/port).
INTERNAL_BASE_URL=

# Sandbox safety switch — keep true until the project is explicitly ready to be indexed
NOINDEX=true

# Reading analytics (scroll depth + "next article" clicks), no cookies/consent banner
ANALYTICS_ENABLED=false

# Tags with fewer than this many articles are marked noindex
TAG_NOINDEX_THRESHOLD=3

# Master switch for the ingestion worker (src/jobs/worker.ts). Off by default —
# no outbound polling of config/sources.yaml feeds happens unless this is "true".
INGEST_ENABLED=false

# `candidate` sources (config/sources.yaml, FACT-167) stay out of autopoll
# even when INGEST_ENABLED=true, unless this is also "true".
INGEST_INCLUDE_CANDIDATES=false

# An event cluster needs this many distinct publishers before it's considered
# "independently confirmed" and eligible for a draft article.
EVENT_CONFIRMATION_MIN_SOURCES=2

# AI draft-assist provider for the editorial pipeline. "none" (default) means
# drafts stay a plain facts-with-citations scaffold for the author to rewrite —
# no AI-generated prose. "mock" is a deterministic stand-in for tests/e2e, no
# key needed. "anthropic" is the real provider (Roman's 08.11 decision, $30/mo
# budget) — do not set AI_API_KEY until the key exists in Autoreg's secrets
# store (FACT-262) and Roman has signed off; the code is ready either way.
AI_PROVIDER=none
AI_MODEL=claude-sonnet-5-5
AI_API_KEY=

# Anti-copypaste: draft shingle-overlap with its most-copied-from source above
# this ratio (0-1) blocks the draft -> published transition (src/lib/ai/originality.ts).
ORIGINALITY_MAX_OVERLAP=0.5

# Hard cap on new AI drafts draftFromEvent() creates per UTC day, so the review
# queue can't outgrow editor review capacity (thin-content guard).
DRAFTS_PER_DAY=20

# Stock-photo providers for the images workflow (docs/sources/images.md).
# Unset = that provider is disabled; Wikimedia Commons needs no key.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Media storage (article covers/images) — S3-compatible, never the container's local
# disk. Unset S3_BUCKET = Payload falls back to local-disk upload (dev-only convenience).
# stage: own MinIO service in docker-compose.yml. prod: Cloudflare R2 (ops-managed).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
